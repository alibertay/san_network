# Normalize all text files to LF in the repository so gofmt, CI and Linux
# checkouts stay consistent regardless of the committer's platform.
* text=auto

*.go       text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.sh       text eol=lf
*.py       text eol=lf
*.pena     text eol=lf
*.proto    text eol=lf
*.json     text eol=lf
*.service  text eol=lf
*.example  text eol=lf
Makefile   text eol=lf
Dockerfile text eol=lf

*.exe      binary
*.db       binary
*.png      binary
*.jpg      binary
