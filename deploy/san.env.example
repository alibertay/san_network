# SAN Network node environment — installed as /etc/san/san.env
#
# The systemd unit loads this file (EnvironmentFile=) and runs
# "sanup --foreground", which honours every SAN_* variable below. Explicit
# command-line flags win over the environment. Edit this file, then:
#
#   sudo systemctl restart san-node
#
# Copy this file to every public node and adjust the host-specific values
# (SAN_ADVERTISE_HOST, SAN_SEED, SAN_DNS_SEEDS, SAN_API_TOKEN, ...).

# ---------------------------------------------------------------------------
# Identity and data (created by deploy/install.sh, 0700, owned by the san user)
# ---------------------------------------------------------------------------
SAN_DATA_DIR=@DATA_DIR@
SAN_KEY_FILE=@DATA_DIR@/san_key.json

# ---------------------------------------------------------------------------
# Networking
#   SAN_HOST         bind address for the three gRPC P2P ports
#   SAN_API_HOST     REST bind address; keep 127.0.0.1 and reverse-proxy it,
#                    or set 0.0.0.0 and always set SAN_API_TOKEN
#   SAN_ADVERTISE_HOST  public DNS name/IP peers dial; required behind NAT
# ---------------------------------------------------------------------------
SAN_HOST=0.0.0.0
SAN_API_HOST=127.0.0.1
SAN_API_PORT=8000
SAN_P2P_PORT=8765
SAN_PEER_PORT=8770
SAN_CONTROLLER_PORT=8769
SAN_ADVERTISE_HOST=@ADVERTISE_HOST@

# ---------------------------------------------------------------------------
# Wide-area discovery
#   Founder of a new chain:  SAN_SEED=true   (no seeds needed)
#   Joining node:            SAN_SEED=false  SAN_DNS_SEEDS=seed.example.com
#   SAN_SEED=auto (default) founds the chain when no seed is reachable.
# ---------------------------------------------------------------------------
SAN_SEED=auto
SAN_DNS_SEEDS=
# SAN_BOOTSTRAP=seed.example.com:8000
SAN_PEERS_CACHE=@DATA_DIR@/peers-cache.json
# The same-machine registry is a fallback; point it at the data dir so the
# service user never needs a writable home directory.
SAN_PEER_REGISTRY=@DATA_DIR@/peers.json
SAN_OUTBOUND_PEERS=8
SAN_MAX_ADDR_ENTRIES=1024

# ---------------------------------------------------------------------------
# Chain and wallet
#   SAN_STAKE reconciles the on-chain stake on every start (empty = untouched)
# ---------------------------------------------------------------------------
SAN_CHAIN_ID=san-devnet-1
# SAN_STAKE=1000
SAN_GENESIS_AMOUNT=10000

# ---------------------------------------------------------------------------
# Storage (LMDB needs a build with -tags lmdb, done by deploy/install.sh)
# ---------------------------------------------------------------------------
SAN_DB_BACKEND=lmdb
SAN_DB_PATH=@DATA_DIR@/node.db

# ---------------------------------------------------------------------------
# REST API authentication: change this before exposing the API
# ---------------------------------------------------------------------------
SAN_API_TOKEN=change-me-before-exposing

# ---------------------------------------------------------------------------
# Faucet (optional; disabled unless SAN_FAUCET=1)
#   POST /faucet {"address":"0x...","amount":10} signs a transfer from this
#   node's identity. Keep the limits tight; every request is irreversible SAN.
#   SAN_FAUCET_AMOUNT  default amount when the request omits one (10 SAN)
#   SAN_FAUCET_MAX     hard cap per request (100 SAN)
#   SAN_FAUCET_COOLDOWN per-address and per-IP cooldown in seconds (60)
# ---------------------------------------------------------------------------
SAN_FAUCET=0
# SAN_FAUCET_AMOUNT=10
# SAN_FAUCET_MAX=100
# SAN_FAUCET_COOLDOWN=60

# ---------------------------------------------------------------------------
# TLS (generated by deploy/install.sh; distribute ca.crt to every peer)
#   Shared public devnet: generate the CA once with
#     sanup cert --ca-only --dir /etc/san/ca
#   then sign each node on the CA machine (ca.key never leaves it):
#     sanup cert --ca-dir /etc/san/ca --dir /etc/san/certs --advertise-host HOST
# ---------------------------------------------------------------------------
SAN_TLS_CERT=@CONFIG_DIR@/certs/node.crt
SAN_TLS_KEY=@CONFIG_DIR@/certs/node.key
SAN_TLS_CA=@CONFIG_DIR@/certs/ca.crt

# ---------------------------------------------------------------------------
# Resource limits
# ---------------------------------------------------------------------------
SAN_MAX_PEERS=64
SAN_RPC_RATE_LIMIT=120
SAN_RPC_MAX_BODY=1048576
# SAN_PRUNE_KEEP=10000
# SAN_SNAPSHOT_INTERVAL=1000

# ---------------------------------------------------------------------------
# Logs
#   SAN_LOG_FORMAT  text (default) or json; json is recommended for journald
#                   and log shippers. Credentials are redacted in both modes.
#   SAN_LOG_LEVEL   debug | info (default) | warn | error
#   The node logs to stderr; systemd captures it. Use:
#     journalctl -u san-node -f
#   sanup --foreground also writes the node state to @DATA_DIR@/sanup.json
#   (used by "sanup --stop" and "sanup --status").
#   Readiness/liveness: probe GET /ready (503 until ready) and GET /health.
# ---------------------------------------------------------------------------
SAN_LOG_FORMAT=json
SAN_LOG_LEVEL=info
